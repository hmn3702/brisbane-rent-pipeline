	partition RtaLatest = m
		mode: import
		source =
				let
				    Source  = Csv.Document(File.Contents(DataFolder & "\mart_rta_suburb_latest.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed   = Table.TransformColumnTypes(Headers, {
				        {"area_name", type text},
				        {"suburb", type text},
				        {"area_postcode", type text},
				        {"location_label", type text},
				        {"dwelling", type text},
				        {"quarter_end", type date},
				        {"median_weekly_rent", type number},
				        {"median_weekly_rent_prev_year", type number},
				        {"rent_yoy_pct", type number},
				        {"median_weekly_rent_5y_ago", type number},
				        {"rent_5y_pct", type number},
				        {"new_bonds", type number},
				        {"bonds_held", type number},
				        {"rent_rank_qld", Int64.Type},
				        {"n_suburbs_ranked", Int64.Type},
				        {"is_tracked", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

