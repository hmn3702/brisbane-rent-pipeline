table DimQuarter
	lineageTag: 139185c0-3d37-5f0e-9387-c83813fbc689
	column quarter_end
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 1b6cec96-60df-5b92-9910-695eaf5688ba
		summarizeBy: none
		sourceColumn: quarter_end

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		lineageTag: c29bc2b6-256e-55b8-b485-6ab5785ba7ec
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = User

	column quarter_label
		dataType: string
		sortByColumn: quarter_index
		lineageTag: 17c02fb6-a82a-56dc-a06c-178aa908d58c
		summarizeBy: none
		sourceColumn: quarter_label

		annotation SummarizationSetBy = User

	column quarter_index
		dataType: int64
		isHidden
		lineageTag: 683062ad-7758-5f84-bcb1-b001e969d6f3
		summarizeBy: none
		sourceColumn: quarter_index

		annotation SummarizationSetBy = User

	partition DimQuarter = m
		mode: import
		source =
				let
				    All   = List.Distinct(RtaTrend[quarter_end] & Gap[quarter_end] & Velocity[quarter_end]),
				    Base  = Table.FromList(All, Splitter.SplitByNothing(), type table [quarter_end = date]),
				    Year  = Table.AddColumn(Base, "year", each Date.Year([quarter_end]), Int64.Type),
				    Label = Table.AddColumn(Year, "quarter_label", each Date.ToText([quarter_end], [Format = "MMM", Culture = "en-AU"]) & " Qtr " & Text.From(Date.Year([quarter_end])), type text),
				    Index = Table.AddColumn(Label, "quarter_index", each Date.Year([quarter_end]) * 4 + Date.QuarterOfYear([quarter_end]), Int64.Type)
				in
				    Index

	annotation PBI_ResultType = Table
