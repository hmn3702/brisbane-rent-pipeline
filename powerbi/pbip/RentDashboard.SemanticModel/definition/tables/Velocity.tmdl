	partition Velocity = m
		mode: import
		source =
				let
				    Source  = Csv.Document(File.Contents(DataFolder & "\mart_listing_velocity_suburb_month.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed   = Table.TransformColumnTypes(Headers, {
				        {"suburb", type text},
				        {"rta_suburb", type text},
				        {"month_start", type date},
				        {"quarter_end", type date},
				        {"dwelling", type text},
				        {"n_listings_closed", Int64.Type},
				        {"median_days_on_market", type number},
				        {"pct_with_price_cut", type number},
				        {"median_final_asking_rent", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

