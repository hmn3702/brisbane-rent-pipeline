table DimDwelling
	lineageTag: 1e69c2c6-06ce-5c58-8b8a-a7fb73acf0bb
	column dwelling
		dataType: string
		sortByColumn: dwelling_sort
		lineageTag: dbb396e0-965e-5056-900e-5a9e70cd7bc9
		summarizeBy: none
		sourceColumn: dwelling

		annotation SummarizationSetBy = User

	column dwelling_sort
		dataType: int64
		isHidden
		lineageTag: 2bfc8a8e-deb7-5aa9-89d2-16bff57f7524
		summarizeBy: none
		sourceColumn: dwelling_sort

		annotation SummarizationSetBy = User

	column dwelling_type
		dataType: string
		lineageTag: 85c7806f-308c-5142-8e33-f54624faf5d7
		summarizeBy: none
		sourceColumn: dwelling_type

		annotation SummarizationSetBy = User

	partition DimDwelling = m
		mode: import
		source =
				let
				    All    = List.Distinct(RtaTrend[dwelling] & Gap[dwelling] & Velocity[dwelling] & Seasonality[dwelling]),
				    Base   = Table.FromList(All, Splitter.SplitByNothing(), type table [dwelling = text]),
				    Order  = {"All dwellings", "Flat 1", "Flat 2", "Flat 3", "House 2", "House 3", "House 4", "Townhouse 2", "Townhouse 3", "Other"},
				    Sorted = Table.AddColumn(Base, "dwelling_sort", each let i = List.PositionOf(Order, [dwelling]) in if i < 0 then 99 else i, Int64.Type),
				    Typed  = Table.AddColumn(Sorted, "dwelling_type", each Text.BeforeDelimiter([dwelling], " "), type text)
				in
				    Typed

	annotation PBI_ResultType = Table
