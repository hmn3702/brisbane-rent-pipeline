	partition RtaTrend = m
		mode: import
		source =
				let
				    Source  = Csv.Document(File.Contents(DataFolder & "\mart_rta_suburb_trend.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed   = Table.TransformColumnTypes(Headers, {
				        {"area_name", type text},
				        {"suburb", type text},
				        {"area_postcode", type text},
				        {"location_label", type text},
				        {"dwelling", type text},
				        {"dwelling_type", type text},
				        {"bedrooms", Int64.Type},
				        {"quarter_end", type date},
				        {"median_weekly_rent", type number},
				        {"rent_yoy_pct", type number},
				        {"new_bonds", type number},
				        {"bonds_held", type number},
				        {"qld_median_weekly_rent", type number},
				        {"premium_vs_qld_pct", type number},
				        {"is_tracked", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
