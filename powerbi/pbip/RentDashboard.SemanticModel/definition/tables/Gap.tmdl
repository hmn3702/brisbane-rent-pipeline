	partition Gap = m
		mode: import
		source =
				let
				    Source  = Csv.Document(File.Contents(DataFolder & "\mart_rent_gap_suburb_quarter.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
