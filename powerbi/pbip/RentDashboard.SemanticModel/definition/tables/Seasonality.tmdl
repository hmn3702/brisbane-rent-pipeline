	partition Seasonality = m
		mode: import
		source =
				let
				    Source  = Csv.Document(File.Contents(DataFolder & "\mart_rta_seasonality.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed   = Table.TransformColumnTypes(Headers, {
				        {"geo_level", type text},
				        {"area_name", type text},
				        {"area_label", type text},
				        {"dwelling", type text},
				        {"quarter_of_year", Int64.Type},
				        {"quarter_label", type text},
				        {"n_years_rent", Int64.Type},
				        {"n_years_bonds", Int64.Type},
				        {"rent_dev_pct", type number},
				        {"rent_t_stat", type number},
				        {"is_rent_significant", type logical},
				        {"pct_years_above_trend", type number},
				        {"rent_dev_pct_before_2020", type number},
				        {"rent_dev_pct_2020_on", type number},
				        {"bonds_dev_pct", type number},
				        {"avg_new_bonds", type number},
				        {"cheapest_rank", Int64.Type},
				        {"is_tracked", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
